# =============================================================================
#  GESTOR DE ARCHIVOS CON FIRMA ELECTRÓNICA — Variables de Entorno
# =============================================================================
#  Copia este archivo a ".env" y rellena cada valor antes de iniciar el server.
#
#    cp .env.example .env          (Linux / macOS)
#    copy .env.example .env        (Windows CMD)
#
#  IMPORTANTE: El archivo ".env" NUNCA debe subirse al repositorio.
#              Está incluido en .gitignore por defecto.
# =============================================================================


# -----------------------------------------------------------------------------
#  BASE DE DATOS — PostgreSQL
# -----------------------------------------------------------------------------
#  En Render se autodefine DATABASE_URL. Para desarrollo local usa las siguientes:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_archivos
DB_USER=postgres
DB_PASSWORD=tu_password_seguro


# -----------------------------------------------------------------------------
#  AUTENTICACIÓN — JSON Web Token (JWT)
# -----------------------------------------------------------------------------
#  Clave secreta para firmar y verificar los tokens JWT.
#  Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_Y_LARGO
JWT_EXPIRES_IN=8h


# -----------------------------------------------------------------------------
#  SERVIDOR — Express
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://tu-app.pages.dev


# -----------------------------------------------------------------------------
#  ALMACENAMIENTO EN LA NUBE — Cloudflare R2 (@aws-sdk/client-s3 v3)
# -----------------------------------------------------------------------------
#  ID de cuenta de Cloudflare (32 caracteres hexadecimales).
#  Se encuentra en el panel de Cloudflare → R2 Overview (lado derecho).
CLOUDFLARE_R2_ACCOUNT_ID=tu_account_id_hexadecimal

#  ID de clave de acceso del token R2.
CLOUDFLARE_R2_ACCESS_KEY_ID=tu_access_key_id

#  Clave secreta de acceso del token R2 (64 caracteres hexadecimales).
#  ⚠️ Requiere permiso "Admin Read & Write" para que el backend cree el bucket automáticamente.
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu_secret_access_key

#  Nombre del Bucket en R2.
#  Reglas: 3 a 63 caracteres, solo minúsculas, números y guiones (sin empezar ni terminar en guion).
#  NO necesitas crearlo manualmente; el backend lo crea al iniciar si no existe.
CLOUDFLARE_R2_BUCKET_NAME=gestion-archivos-docs

#  Límite de tamaño para subida de archivos PDF en megabytes (opcional, por defecto 20).
MAX_UPLOAD_MB=20


# -----------------------------------------------------------------------------
#  FIRMA ELECTRÓNICA INSTITUCIONAL — PAdES-BES (En memoria / Render)
# -----------------------------------------------------------------------------
#  Certificado PKCS#12 (.p12 / .pfx) codificado en Base64.
#  Genera el base64 en Linux/macOS: base64 -w 0 certificado.p12
#  Genera el base64 en Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.p12")) | Set-Clipboard
CERT_INSTITUCIONAL_P12_BASE64=MIIK...CONTENIDO_BASE64_DEL_CERTIFICADO_P12...

#  Contraseña del certificado institucional.
CERT_INSTITUCIONAL_PASSWORD=password_del_certificado_institucional
