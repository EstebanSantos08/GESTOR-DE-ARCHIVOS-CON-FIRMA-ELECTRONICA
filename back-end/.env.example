# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_archivos
DB_USER=postgres
DB_PASSWORD=tu_password

# JWT
JWT_SECRET=cambia_este_secreto_super_seguro_en_produccion
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
NODE_ENV=development

# Archivos
UPLOADS_DIR=./uploads
CERTS_DIR=./certs
MAX_FILE_SIZE_MB=10

# Certificado institucional (para firma PAdES)
CERT_P12_PATH=./certs/firma_institucional.p12
CERT_P12_PASSWORD=password_del_certificado
