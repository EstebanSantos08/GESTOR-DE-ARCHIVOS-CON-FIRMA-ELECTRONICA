# =============================================================================
#  GESTOR DE ARCHIVOS CON FIRMA ELECTRÓNICA — Variables de Entorno
# =============================================================================
#  Copia este archivo a ".env" y rellena cada valor antes de iniciar el server.
#
#    cp .env.example .env          (Linux / macOS)
#    copy .env.example .env        (Windows CMD)
#
#  IMPORTANTE: El archivo ".env" NUNCA debe subirse al repositorio.
#              Está incluido en .gitignore por defecto.
# =============================================================================


# -----------------------------------------------------------------------------
#  BASE DE DATOS — PostgreSQL
# -----------------------------------------------------------------------------
#  Host donde corre PostgreSQL. En desarrollo local suele ser "localhost".
DB_HOST=localhost

#  Puerto de PostgreSQL. El valor por defecto es 5432.
#  Ajústalo si tu instalación usa otro puerto (ej. 5433).
DB_PORT=5432

#  Nombre de la base de datos. Debe existir antes de iniciar el servidor.
#  Créala con:  createdb gestion_archivos
DB_NAME=gestion_archivos

#  Usuario de PostgreSQL con permisos sobre la base de datos.
DB_USER=postgres

#  Contraseña del usuario de PostgreSQL.
#  ⚠️  En producción usa una contraseña larga y aleatoria.
DB_PASSWORD=tu_password_seguro


# -----------------------------------------------------------------------------
#  AUTENTICACIÓN — JSON Web Token (JWT)
# -----------------------------------------------------------------------------
#  Clave secreta para firmar y verificar los tokens JWT.
#  ⚠️  CRÍTICO: Cambia este valor en producción por una cadena aleatoria larga.
#      Genera una con:
#        node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_Y_LARGO

#  Tiempo de expiración del token JWT.
#  Formato: "8h" (horas), "7d" (días), "30m" (minutos).
JWT_EXPIRES_IN=8h


# -----------------------------------------------------------------------------
#  SERVIDOR — Express
# -----------------------------------------------------------------------------
#  Puerto en el que escucha el servidor Express.
#  El front-end (Vite) apunta a http://localhost:3000/api por defecto.
PORT=3000

#  Entorno de ejecución. Controla el nivel de logging de Sequelize.
#  Valores válidos: "development" | "production" | "test"
NODE_ENV=development


# -----------------------------------------------------------------------------
#  ALMACENAMIENTO DE ARCHIVOS
# -----------------------------------------------------------------------------
#  Directorio donde se guardan los PDFs subidos por los usuarios.
#  La ruta es relativa al directorio "back-end/".
#  ⚠️  Esta carpeta NO debe subirse al repositorio (ver .gitignore).
UPLOADS_DIR=./uploads

#  Directorio donde se almacenan los certificados digitales (.p12 / .pfx).
#  ⚠️  Esta carpeta NO debe subirse al repositorio (ver .gitignore).
CERTS_DIR=./certs

#  Tamaño máximo permitido para un archivo subido, en megabytes.
MAX_FILE_SIZE_MB=10


# -----------------------------------------------------------------------------
#  FIRMA ELECTRÓNICA — PAdES-BES (Certificado Institucional)
# -----------------------------------------------------------------------------
#  Ruta al certificado PKCS#12 (.p12 / .pfx) de la institución.
#  Se usa como fallback cuando el firmante no tiene certificado personal.
#  La ruta es relativa al directorio "back-end/".
CERT_P12_PATH=./certs/firma_institucional.p12

#  Contraseña del certificado PKCS#12 institucional.
#  ⚠️  En producción guarda esta contraseña en un gestor de secretos
#      (AWS Secrets Manager, Azure Key Vault, HashiCorp Vault, etc.)
CERT_P12_PASSWORD=password_del_certificado_institucional
