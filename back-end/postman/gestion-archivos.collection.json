    {
      "name": "📄 Documentos",
      "item": [
        {
          "name": "Subir PDF",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "http://localhost:3000/api/documentos/subir",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "archivo",      "type": "file",  "src": [], "description": "Seleccionar archivo PDF" },
                { "key": "facultad_id",  "value": "{{facultad_id}}", "type": "text" },
                { "key": "actividad_id", "value": "{{actividad_id}}", "type": "text" }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["// ⚠️ Usar token del DOCENTE y seleccionar un archivo PDF real"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('PDF subido — estado PENDIENTE, firmante asignado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const doc = pm.response.json();",
                  "  pm.expect(doc.estado).to.eql('PENDIENTE');",
                  "  pm.expect(doc.firmante_actual_id).to.not.be.null;",
                  "  pm.environment.set('documento_id', doc.id);",
                  "  console.log('documento_id:', doc.id, '| firmante_actual_id:', doc.firmante_actual_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Subir archivo no-PDF (debe fallar)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "http://localhost:3000/api/documentos/subir",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "archivo", "type": "file", "src": [], "description": "Seleccionar un .docx o .jpg" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rechaza archivo no-PDF', () => { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar mis documentos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "http://localhost:3000/api/documentos",
              "query": [
                { "key": "estado", "value": "PENDIENTE", "disabled": true, "description": "PENDIENTE | FIRMADO_DECANO | COMPLETADO | RECHAZADO" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lista retornada', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener documento por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "http://localhost:3000/api/documentos/{{documento_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Documento con relaciones', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const doc = pm.response.json();",
                  "  pm.expect(doc).to.have.property('estado');",
                  "  pm.expect(doc).to.have.property('subidoPor');",
