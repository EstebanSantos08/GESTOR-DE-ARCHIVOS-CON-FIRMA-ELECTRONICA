# =============================================================================
#  FRONTEND — Variables de Entorno (Vite)
# =============================================================================
#  Copia este archivo a ".env" para desarrollo local, o configura las
#  variables directamente en Cloudflare Pages > Settings > Environment Variables
#
#  IMPORTANTE: Todas las variables DEBEN empezar con VITE_ para que Vite
#  las exponga al cliente. Variables sin ese prefijo serán ignoradas.
# =============================================================================

# URL base de la API del backend.
# - Desarrollo local:  http://localhost:3000/api
# - Producción:        https://tu-app.onrender.com/api  ← URL de tu servicio en Render
VITE_API_URL=http://localhost:3000/api
